    { "project_id": "p_001", "task_id": "t_002", "organization_id": "acme", "title": "Build navbar", "status": "in_progress", "priority": "medium", "assignee_id": "u_002", "due_date": "2026-10-10", "created_at": "2026-09-04T09:00:00Z" },

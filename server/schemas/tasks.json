{
  "table": "tasks",
  "description": "Work items inside a project, assigned to users.",
  "partitionKey": "project_id",
  "sortKey": "task_id",
  "attributes": [
    { "name": "project_id", "type": "string", "description": "ID of the project the task belongs to." },
    { "name": "task_id", "type": "string", "description": "Unique task ID (e.g. t_001)." },
    { "name": "organization_id", "type": "string", "description": "ID of the organization that owns the project." },
    { "name": "title", "type": "string", "description": "Short task title." },
    { "name": "status", "type": "string", "description": "Task status: todo, in_progress or done." },
    { "name": "priority", "type": "string", "description": "Task priority: low, medium or high." },
    { "name": "assignee_id", "type": "string", "description": "User ID of the person assigned to the task." },
    { "name": "due_date", "type": "string", "description": "Due date in YYYY-MM-DD format." },
    { "name": "created_at", "type": "string", "description": "ISO 8601 timestamp when the task was created." }
  ],
  "indexes": [
    { "name": "assignee-due-date-index", "partitionKey": "assignee_id", "sortKey": "due_date" },
    { "name": "project-status-index", "partitionKey": "project_id", "sortKey": "status" }
  ],
  "accessPatterns": [
    { "description": "List all tasks of a project." },
    { "description": "Get a single task by project ID and task ID." },
    { "description": "List tasks assigned to a user, optionally within a due date range.", "index": "assignee-due-date-index" },
    { "description": "List tasks of a project with a given status.", "index": "project-status-index" }
  ],
  "exampleRecords": [

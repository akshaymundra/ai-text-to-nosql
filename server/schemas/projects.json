    { "name": "name", "type": "string", "description": "Project name." },
    { "name": "status", "type": "string", "description": "Project status: active or archived." },
    { "name": "owner_id", "type": "string", "description": "User ID of the project owner." },
    { "name": "created_at", "type": "string", "description": "ISO 8601 timestamp when the project was created." }
  ],
  "indexes": [
    { "name": "owner-created-at-index", "partitionKey": "owner_id", "sortKey": "created_at" }
  ],
  "accessPatterns": [

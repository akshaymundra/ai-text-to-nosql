{
  "table": "users",
  "description": "People who belong to an organization and can log in to the product.",
  "partitionKey": "user_id",
  "attributes": [
    { "name": "user_id", "type": "string", "description": "Unique user ID (e.g. u_001)." },
    { "name": "organization_id", "type": "string", "description": "ID of the organization the user belongs to." },
    { "name": "email", "type": "string", "description": "User email address." },
    { "name": "name", "type": "string", "description": "Full name of the user." },
    { "name": "role", "type": "string", "description": "Role in the organization: admin, member or viewer." },
    { "name": "status", "type": "string", "description": "Account status: active, invited or disabled." },
    { "name": "created_at", "type": "string", "format": "timestamp", "description": "ISO 8601 timestamp when the user signed up." },
    { "name": "last_login_at", "type": "string", "format": "timestamp", "description": "ISO 8601 timestamp of the user's most recent login. Absent if never logged in." }
  ],
  "indexes": [
    { "name": "organization-created-at-index", "partitionKey": "organization_id", "sortKey": "created_at" },
    { "name": "email-index", "partitionKey": "email" }
  ],
  "accessPatterns": [
    { "description": "Get a user by user ID." },
    { "description": "List users of an organization, optionally within a signup date range.", "index": "organization-created-at-index" },
    { "description": "Find a user by exact email address.", "index": "email-index" }
  ],
  "exampleRecords": [

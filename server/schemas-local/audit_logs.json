{
  "table": "audit_logs",
  "description": "Security and activity events recorded per organization.",
  "partitionKey": "organization_id",
  "sortKey": "created_at",
  "attributes": [
    { "name": "organization_id", "type": "string", "description": "ID of the organization the event belongs to." },
    { "name": "created_at", "type": "string", "format": "timestamp", "description": "ISO 8601 timestamp when the event happened." },
    { "name": "actor_id", "type": "string", "description": "User ID of the user who performed the action." },
    { "name": "action", "type": "string", "description": "Event type: user.login, user.invite, user.disable, project.create or task.update." },
    { "name": "resource_type", "type": "string", "description": "Type of the affected resource: user, project or task." },
    { "name": "resource_id", "type": "string", "description": "ID of the affected resource." }
  ],
  "indexes": [
    { "name": "actor-created-at-index", "partitionKey": "actor_id", "sortKey": "created_at" }
  ],
  "accessPatterns": [
    { "description": "List audit events of an organization, optionally within a time range." },
    { "description": "List audit events performed by a user, optionally within a time range.", "index": "actor-created-at-index" }
  ],
  "exampleRecords": [

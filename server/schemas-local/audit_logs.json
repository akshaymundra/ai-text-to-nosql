    { "organization_id": "acme", "created_at": "2026-10-01T10:05:00Z", "actor_id": "u_005", "action": "user.login", "resource_type": "user", "resource_id": "u_005" },
    { "organization_id": "globex", "created_at": "2026-09-12T15:35:00Z", "actor_id": "u_007", "action": "user.login", "resource_type": "user", "resource_id": "u_007" },

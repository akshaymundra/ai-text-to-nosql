    { "organization_id": "acme", "created_at": "2026-09-05T09:00:00Z", "actor_id": "u_002", "action": "project.create", "resource_type": "project", "resource_id": "p_002" },
    { "organization_id": "acme", "created_at": "2026-09-20T17:10:00Z", "actor_id": "u_002", "action": "task.update", "resource_type": "task", "resource_id": "t_004" },
